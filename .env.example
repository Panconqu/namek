# ============================================
#  NAMEK - backend de cuentas/auditoría (RUST)
#  Copia este archivo a `.env` y rellena los
#  valores REALES (`.env` está en .gitignore,
#  NUNCA se sube a GitHub ni se pega en chats).
# ============================================

# PostgreSQL (Neon) — reemplaza con tu string de conexión real (con contraseña)
DATABASE_URL=postgresql://usuario:password@host/db?sslmode=require

# Secreto del servidor (úselo el backend, si aplica)
SERVER_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria

# Credenciales del panel admin (solo tú)
# Requisitos: >=12 caracteres, sin 'admin'/'password'/'admin123'
ADMIN_USER=mi_admin
ADMIN_PASS=cambia-esta-contrasena-fuerte-por-favor

# Puerto del backend
BACKEND_PORT=8787
